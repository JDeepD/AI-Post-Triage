#. Plugin Name of the plugin
#: wire-desk.php
#: inc/Modules/Queue/Queue_Screen.php:105
#: inc/Modules/Queue/Queue_Screen.php:106
#: build/editor.js:1
msgid "Wire Desk"
msgstr "Wire Desk"

#. Plugin URI of the plugin
#: wire-desk.php
msgid "https://github.com/JDeepD/wire-desk"
msgstr "https://github.com/JDeepD/wire-desk"

#. Description of the plugin
#: wire-desk.php
msgid "Flags high-priority wire-ingested posts with a decision model and gives editors a review queue to decide what gets published."
msgstr "Marca las entradas de agencia de alta prioridad con un modelo de decisión y ofrece a los editores una cola de revisión para decidir qué se publica."

#. Author of the plugin
#: wire-desk.php
msgid "Jaydeep Das"
msgstr "Jaydeep Das"

#. Author URI of the plugin
#: wire-desk.php
msgid "https://github.com/JDeepD"
msgstr "https://github.com/JDeepD"

