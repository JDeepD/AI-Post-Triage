#. Plugin Name of the plugin
#: wire-desk.php
#: inc/Modules/Queue/Queue_Screen.php:105
#: inc/Modules/Queue/Queue_Screen.php:106
#: build/editor.js:1
msgid "Wire Desk"
msgstr "Wire Desk"

#. Plugin URI of the plugin
#: wire-desk.php
msgid "https://github.com/JDeepD/wire-desk"
msgstr "https://github.com/JDeepD/wire-desk"

#. Description of the plugin
#: wire-desk.php
msgid "Flags high-priority wire-ingested posts with a decision model and gives editors a review queue to decide what gets published."
msgstr "Signale les dépêches d’agence prioritaires à l’aide d’un modèle de décision et offre aux éditeurs une file de relecture pour décider de ce qui est publié."

#. Author of the plugin
#: wire-desk.php
msgid "Jaydeep Das"
msgstr "Jaydeep Das"

#. Author URI of the plugin
#: wire-desk.php
msgid "https://github.com/JDeepD"
msgstr "https://github.com/JDeepD"

